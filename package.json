{
  "name": "agadir-bus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "basemap": "node scripts/extract-basemap.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "lint": "oxlint src scripts tests",
    "check": "tsc --noEmit && oxlint src scripts tests && node --test \"tests/**/*.test.ts\"",
    "release": "bun run check && vite build",
    "deploy:preview": "bun run release && bunx wrangler@4.139.0 pages deploy dist --project-name tobis --branch preview",
    "deploy:live": "bun run release && bunx wrangler@4.139.0 pages deploy dist --project-name tobis --branch master",
    "data:pack": "node scripts/pack-data.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "council:fetch": "node scripts/fetch-facebook.mjs",
    "council:inbox": "node scripts/inbox.mjs"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@mapbox/mapbox-gl-rtl-text": "0.4.0",
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "5.24.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@tabler/icons": "3.24.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.0",
    "axe-core": "4.10.2",
    "oxlint": "1.88.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "packageManager": "bun@1.4.3",
  "license": "MIT"
}
